# Copy to .env for local use. Never commit real values. No secrets are required today.

# Listening port and interface. Use HOST=0.0.0.0 only when deploying behind a platform proxy.
PORT=3000
HOST=127.0.0.1

# Comma-separated hostnames (no port) allowed in the Host header. Default: localhost,127.0.0.1,[::1]
# For a deployment, set to your public hostname, e.g. mcp.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origin hostnames (no scheme/port) allowed when an Origin header is sent.
# Requests without an Origin header (non-browser MCP clients) are always accepted.
ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# Maximum request body size in bytes (default 65536).
MAX_BODY_BYTES=65536

# Per-client requests per minute on /mcp, per instance (default 120).
RATE_LIMIT_PER_MINUTE=120

# Set to true ONLY behind a trusted proxy so X-Forwarded-For identifies the client for rate limiting.
TRUST_PROXY=false

# Where the "Consult Clinic Living Plus" button points (http/https). If unset, the button is disabled.
CLP_CONSULTATION_URL=
