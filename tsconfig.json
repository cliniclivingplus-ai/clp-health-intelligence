{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "ui-src/**/*.ts",
    "harness/**/*.ts"
  ]
}
